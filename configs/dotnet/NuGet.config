<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- <clear/> makes this file the single source of truth: user-level
       (%APPDATA%\NuGet) and machine-level sources are ignored while it is
       in effect. huaweicloud is a transparent cache/proxy of nuget.org and
       is tried first; nuget.org stays last as a fallback for packages the
       mirror has not cached yet. -->
  <packageSources>
    <clear />
    <add key="huaweicloud" value="https://mirrors.huaweicloud.com/repository/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
