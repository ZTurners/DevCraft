{
    "install": {
        "check_xcodes": {
            "execute": {
                "command": [
                    "if path=$(xcode-select -p 2>/dev/null);",
                    " then mkdir -pv ${workspace}/xcode/CommandLineTools && ln -sfv \"$path\" ${workspace}/xcode/CommandLineTools; ",
                    " else echo \"Error: xcode-select failed - install Xcode or Command Line Tools\"; ",
                    "fi"
                ]
            }
        }
    },
    "generator_active_batch":{
        "file_path": "${workspace}/xcode/active",
        "environments": {
            "set": {
                "DEVELOPER_DIR": "${workspace}/xcode/CommandLineTools"
            }
        }
    }
}
