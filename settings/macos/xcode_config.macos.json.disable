{
    "install": {
        "xcodes": {
            "download": {
                "src": 
                {
                    "url": "https://github.com/XcodesOrg/xcodes/releases/download/1.6.2/xcodes-1.6.2.macos.arm64.tar.gz"
                },
                "dest": "${workspace}/.downloads/xcodes-1.6.2.macos.arm64.tar.gz"
            },
            "unzip": {
                "src": "${workspace}/.downloads/xcodes-1.6.2.macos.arm64.tar.gz",
                "src_sub_folder": "xcodes/1.6.2/bin",
                "dest": "${workspace}/xcodes"
            },
            "make_executable_permission": [
                "${workspace}/xcodes/xcodes"
            ],
            "execute": {
                "command": [
                    "mkdir -p ${workspace}/xcodes/latest && ${workspace}/xcodes/xcodes", 
                    "install", "--latest", 
                    "--directory", "${workspace}/xcodes"
                ]
            }
        }
    },
    "generator_active_batch":{
        "file_path": "${workspace}/xcode/active",
        "environments": {
            "set": {
                "DEVELOPER_DIR": "${workspace}/xcode/CommandLineTools"
            }
        }
    }
}
