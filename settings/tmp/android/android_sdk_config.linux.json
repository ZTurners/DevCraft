{
  "install": 
  [
    {
      "name": "android_sdk_bootstrap",
      "target_folder": "${workspace}/android/android_sdk/cmdline-tools/booststrap",
      "download":
      {
        "src": 
        {
          "url": "https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip"
        },
        "dest": "${workspace}/.downloads/commandlinetools-linux-13114758_latest.zip"
      },
      "unzip":
      {
        "src": "${workspace}/.downloads/commandlinetools-linux-13114758_latest.zip",
        "src_sub_folder": "cmdline-tools",
        "dest": "${workspace}/android/android_sdk/cmdline-tools/booststrap"
      },
      "make_execute_permission": [
        "${workspace}/android/android_sdk/cmdline-tools/booststrap/bin"
      ]
    },
    {
      "name": "android_sdk",
      "target_folder": "${workspace}/android/android_sdk",
      "always_update": true,
      "execute_command": [
        "${workspace}/android/android_sdk/commandline-tools/booststrap/bin/sdkmanager",
        "--sdk_root=${workspace}/android/android_sdk",
        "--install",
        "\"ndk;29.0.13599879\"",
        "\"build-tools;36.0.0-rc5\"",
        "\"ndk-bundle\"",
        "\"platform-tools\"",
        "\"cmdline-tools;19.0\""
      ]
    }
  ],
  "generator_active_batch":
  {
    "file_path": "${workspace}/android/android_sdk/active",
    "environments":
    {
      "set": 
      {
        "ANDROID_SDK_ROOT": "${workspace}/android/android_sdk"
      },
      "prepend": 
      [
        {"PATH" : "${workspace}/android/android_sdk/cmdline-tools/bin"},
        {"PATH" : "${workspace}/android/android_sdk/platform-tools"}
      ]
    }
  }
}