{
  "install": 
  [
    {
      "name": "jdk-25",
      "target_folder": "${workspace}/jdk/jdk-25",
      "download":
      {
        "src": 
        {
          "url": "https://download.oracle.com/java/25/latest/jdk-25_linux-aarch64_bin.tar.gz",
          "auth_required": false
        },
        "dest": "${workspace}/.downloads/jdk-25_linux-aarch64_bin.tar.gz"
      },
      "unzip":
      {
        "src": "${workspace}/.downloads/jdk-25_linux-aarch64_bin.tar.gz",
        "src_sub_folder": "jdk-25",
        "dest": "${workspace}/jdk/jdk-25"
      }
    }
  ],
  "generator_active_batch":
  {
    "file_path": "${workspace}/jdk/active",
    "environments":
    {
      "set": 
      {
        "JAVA_HOME": "${workspace}/jdk/jdk-25"
      },
      "prepend": 
      [
        {"PATH" : "${workspace}/jdk/jdk-25/bin"}
      ]
    }
  }
}