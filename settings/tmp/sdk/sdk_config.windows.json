{
  "install": 
  [
    {
      "name": "vulkansdk-windows-x64-1.4.328",
      "target_folder": "${workspace}/sdk/vulkansdk_windows_x64_1.4.328.1",
      "download":
      {
        "src": 
        {
          "url": "https://sdk.lunarg.com/sdk/download/1.4.328.1/windows/vulkansdk-windows-X64-1.4.328.1.exe",
          "auth_required": false
        },
        "dest": "${workspace}/.downloads/vulkansdk-windows-X64-1.4.328.1.exe"
      },
      "execute_command": [
        "${download_file}",
        "install",
        "copy_only=1",
        "--root=${target_folder}"
      ],
      "execute_command_as_admin": false
    },
    {
      "name": "vulkansdk-linux-x86_64-1.4.328.1",
      "target_folder": "${workspace}/sdk/vulkansdk_linux_x86_64_1.4.328.1",
      "download":
      {
        "src": 
        {
          "url": "https://sdk.lunarg.com/sdk/download/1.4.328.1/linux/vulkansdk-linux-x86_64-1.4.328.1.tar.xz",
          "auth_required": false
        },
        "dest": "${workspace}/.downloads/vulkansdk-linux-x86_64-1.4.328.1.tar.xz"
      },
      "unzip":
      {
        "src": "${workspace}/.downloads/vulkansdk-linux-x86_64-1.4.328.1.tar.xz",
        "src_sub_folder": "1.4.328.1/x86_64",
        "dest": "${workspace}/sdk/vulkansdk_linux_x86_64_1.4.328.1"
      }
    }
  ],
  "generator_active_batch":
  {
    "file_path": "${workspace}/sdk/active",
    "environments":
    {
      "set": 
      {
        "VK_LAYER_PATH": "${workspace}/sdk/vulkansdk_windows_x64_1.4.328.1/Bin"
      },
      "prepend": 
      [
        {"PATH" : "${workspace}/sdk/vulkansdk_windows_x64_1.4.328.1/Bin"}
      ]
    }
  }
}