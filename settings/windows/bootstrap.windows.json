{
  "install": 
  {
    "boostrap":
    {
      "copy":
      {
        "src": "${settings}/content/bootstrap/scripts/macos",
        "dest": "${workspace}",
        "force_update": true
      },
      "make_execute_permission": [
        "${workspace}/active_with_bash.macos.sh",
        "${workspace}/active_with_vscode.macos.sh",
        "${workspace}/active.macos.sh"
      ]
    }
  }
}