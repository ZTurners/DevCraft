{
  "install": 
  {
    "conan_boostrap":
    {
      "copy":
      {
        "src": "${settings}/content/conan",
        "dest": "${workspace}/conan/.conan"
      }
    },
    "conan_profile_detect":
    {
      "environments":
      {
        "set": 
        {
            "CONAN_HOME": "${workspace}/conan/.conan",
            "CONAN_USE_ALWAYS_SHORT_PATHS": "1"
        },
        "prepend": 
        [
        ]
      },
      "execute":
      {
        "command": [
          "conan", "profile", "detect",
          "--force"
        ]
      }
    },
    "conan":
    {
      "execute":
      {
        "command": [
          "conan", "install", 
          "${settings}/content/conan/conanfile.txt",
          "--update",
          "--generator", "CMakeToolchain",
          "--generator", "VirtualBuildEnv",
          "--output-folder", "${workspace}/conan",
          "--build", "never",
          "--profile", "${settings}/content/conan/profiles/builder/conan_builder_profile.windows.txt"
        ]
      }
    }
  },
  "generator_active_batch":
  {
    "file_path": "${workspace}/conan/active",
    "environments":
    {
        "set": 
        {
            "CONAN_HOME": "${workspace}/conan/.conan",
            "CONAN_USE_ALWAYS_SHORT_PATHS": "1"
        }
    }
  }
}